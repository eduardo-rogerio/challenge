# Valores para uso local (rede do Docker Compose). Sem segredos reais.
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s
CHECK_TIMEOUT=2s
# Prazo de uma execução idempotente em andamento antes de poder ser retomada.
IDEMPOTENCY_LEASE=30s

DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_MAX_RECEIVE_COUNT=5

# Worker de referências pendentes (retry com backoff exponencial e expiração).
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_TTL=1h
REFERENCE_BASE_DELAY=5s
REFERENCE_MAX_DELAY=5m
REFERENCE_POLL_INTERVAL=1s
REFERENCE_CLAIM_LEASE=30s
REFERENCE_BATCH_SIZE=20
